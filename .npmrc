# Netlify's function bundler (zip-it-and-ship-it) traces packages listed in
# external_node_modules starting from the repo-root node_modules, and copies
# what it finds into the function. pnpm's default layout is symlinked and
# strict: @prisma/client exists only under packages/db/node_modules, because
# only that workspace package depends on it. Nothing sits at the root, so the
# bundler found nothing to copy and the deployed function crashed at runtime
# with:
#
#   ERR_MODULE_NOT_FOUND: Cannot find package '@prisma/client'
#   imported from /var/task/netlify/functions/app.mjs
#
# A hoisted layout is flat, the way npm arranges things, so every dependency
# is visible at the root and both external_node_modules and included_files
# resolve. This affects installation layout only -- the lockfile is unchanged,
# so `pnpm install --frozen-lockfile` still works locally, in Docker and on
# Netlify.
# Do NOT add auto-install-peers here. pnpm records that setting inside
# pnpm-lock.yaml, so overriding it fails `--frozen-lockfile` with
# ERR_PNPM_LOCKFILE_CONFIG_MISMATCH and aborts the build. node-linker is
# a layout setting only and is not recorded in the lockfile, so it is safe.
node-linker=hoisted

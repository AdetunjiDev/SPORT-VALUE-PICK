{
  "name": "@sportybet/crawler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "start": "dotenv -e ../../.env -- tsx src/index.ts",
    "start:docker": "tsx src/index.ts",
    "telegram:login": "dotenv -e ../../.env -- tsx scripts/telegram-login.ts",
    "scan:once": "dotenv -e ../../.env -- tsx src/runOnce.ts",
    "verify:once": "dotenv -e ../../.env -- tsx src/runVerify.ts",
    "ai:once": "dotenv -e ../../.env -- tsx src/runAi.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sportybet/db": "workspace:*",
    "@sportybet/shared": "workspace:*",
    "fast-xml-parser": "^4.5.0",
    "ioredis": "^6.0.0",
    "node-tesseract-ocr": "^2.2.1",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "dotenv-cli": "^7.4.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}

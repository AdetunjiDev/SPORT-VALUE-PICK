# =====================================================
# SPORTYBET AI BOOKING CODE INTELLIGENCE — ENV TEMPLATE
# Copy to `.env` and fill in. Never commit the real .env.
# =====================================================

# ---- Core ----
NODE_ENV=development

# ---- Dashboard password gate ----
# Set this to require a password to load ANY page of the dashboard. Leave blank
# for open local access. Use a strong value before exposing the app anywhere.
APP_PASSWORD=

# ---- Admin key ----
# Only admins see source-revealing info (which Telegram channel a code came
# from, crawl activity). Become admin on a browser by visiting /admin?key=<this>.
# Leave blank = everyone who's signed in is admin (owner not locked out).
ADMIN_KEY=

# ---- Database (Postgres) ----
# Matches docker-compose service `postgres`
POSTGRES_USER=sportybet
POSTGRES_PASSWORD=sportybet_dev_pw
POSTGRES_DB=sportybet
DATABASE_URL=postgresql://sportybet:sportybet_dev_pw@localhost:5432/sportybet?schema=public
# Prisma runs migrations over a non-pooled connection. Locally = DATABASE_URL.
DIRECT_URL=postgresql://sportybet:sportybet_dev_pw@localhost:5432/sportybet?schema=public

# ---- Supabase (hosted Postgres) ----
# Copy BOTH strings from the Supabase dashboard → Connect. Do not hand-write
# the hostnames; they differ per project and region.
#   DATABASE_URL = Transaction pooler (port 6543) + ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = Session pooler   (port 5432)
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ---- Redis (BullMQ queues + cache) ----
REDIS_URL=redis://localhost:6379

# ---- User accounts & sessions ----
# Secret for signing login session cookies. Set a long random string in prod —
# when blank it is derived from APP_PASSWORD+ADMIN_KEY (or random per boot).
SESSION_SECRET=
# Public self-registration (needed to sell subscriptions). Set 0 to disable.
ALLOW_SIGNUP=1
# Absolute origin for payment callbacks when behind a domain/proxy,
# e.g. https://app.example.com (blank = derived from request Host).
PUBLIC_BASE_URL=

# ---- Paystack billing (NGN) ----
# Secret key from dashboard.paystack.com (sk_test_... / sk_live_...).
# Blank = checkout disabled; the /upgrade page still renders with a notice.
# Also set your webhook URL in the Paystack dashboard to <origin>/paystack/webhook
PAYSTACK_SECRET_KEY=
# One-off pass prices in naira.
PLAN_DAILY_NGN=500
PLAN_WEEKLY_NGN=1500
PLAN_MONTHLY_NGN=5000

# ---- Auth / JWT ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- OAuth (optional, fill when enabling) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ---- Crawler / Data sources (compliant paths) ----
# Google News RSS + Reddit public JSON need no key.
# Add these for richer coverage:
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=
SERPAPI_KEY=

# ---- Telegram official API (MTProto) — real-time human-code discovery ----
# Free credentials from https://my.telegram.org → API development tools.
# Then run once:  pnpm --filter @sportybet/crawler telegram:login
# and paste the printed session below. All three must be set to switch it on;
# leave blank to keep using the public web-preview scrape.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_MSG_LIMIT=25
TELEGRAM_OCR_PER_CHANNEL=4

# ---- Football data providers (free tiers available) ----
FOOTBALL_DATA_API_KEY=
THE_ODDS_API_KEY=

# ---- API-Football (api-sports.io) — PREMIUM predictions feed ----
# Leave APIFOOTBALL_KEY blank to keep the adapter OFF (app runs free, no calls).
# Get a key: https://dashboard.api-football.com  (free tier = 100 requests/day).
# If you subscribed via RapidAPI instead, set APIFOOTBALL_PROVIDER=rapidapi.
APIFOOTBALL_KEY=
APIFOOTBALL_PROVIDER=apisports
# Stay under the free 100/day cap; lower these if you see quota warnings.
APIFOOTBALL_DAILY_BUDGET=80
APIFOOTBALL_PREDS_PER_CYCLE=6

# ---- AI ----
OPENAI_API_KEY=
BYTEZ_API_KEY=
ML_SERVICE_URL=http://localhost:8000

# ---- Payments (fill when enabling billing) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# ---- Email delivery (Auto-Pilot code emails, via Resend) ----
# Leave blank to keep email OFF (users still get the in-app notification).
# Get a free key at resend.com (3,000 emails/month free). EMAIL_FROM must be on
# a domain verified in Resend; for a quick test use onboarding@resend.dev.
RESEND_API_KEY=
EMAIL_FROM=Sporty Value Pick AI <onboarding@resend.dev>

# ---- Crawler scheduling ----
DEFAULT_CRAWL_INTERVAL_SEC=180

# ---- Web / API URLs ----
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

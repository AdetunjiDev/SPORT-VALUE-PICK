{
  "name": "sportybet-ai-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "SportyBet AI Booking Code Intelligence — discover, verify, analyze, rank and recommend Human and AI-powered booking codes.",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @sportybet/db generate",
    "db:migrate": "pnpm --filter @sportybet/db migrate",
    "db:push": "pnpm --filter @sportybet/db push",
    "db:seed": "pnpm --filter @sportybet/db seed",
    "db:studio": "pnpm --filter @sportybet/db studio",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "stack:up": "docker compose up -d --build",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "netlify:build": "bash scripts/netlify-build.sh"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "esbuild"]
  }
}
